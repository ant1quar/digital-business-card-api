generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillCategory {
  FRONTEND
  TESTING_QUALITY
  BACKEND_INFRASTRUCTURE
  AI_ASSISTED
}

enum SkillLevel {
  EXPERT
  ADVANCED
  PROFICIENT
}

model Profile {
  id          String       @id @default(uuid())
  name        String
  description String       @db.Text
  location    String
  email       String
  githubUrl   String?
  linkedInUrl String?
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Skill {
  id        String        @id @default(uuid())
  profileId String
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  SkillCategory
  level     SkillLevel?
  sortOrder Int           @default(0)

  @@index([profileId])
}

model Experience {
  id           String        @id @default(uuid())
  profileId    String
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  position     String
  periodLabel  String
  subtitle     String?       @db.Text
  sortOrder    Int           @default(0)
  achievements Achievement[]

  @@index([profileId])
}

model Achievement {
  id           String     @id @default(uuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  text         String     @db.Text
  sortOrder    Int        @default(0)

  @@index([experienceId])
}

model Project {
  id          String  @id @default(uuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  description String? @db.Text
  link        String?
  sortOrder   Int     @default(0)

  @@index([profileId])
}
